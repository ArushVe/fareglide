# Personal settings belong in .env.local and must not be committed.
FAREGLIDE_REPORT_TO=you@example.com
FAREGLIDE_REPORT_TIME=08:00
FAREGLIDE_TIME_ZONE=America/Los_Angeles

# Resend test mode can email the address that owns the Resend account. A
# verified domain is required before sending to other recipients.
RESEND_API_KEY=
FAREGLIDE_REPORT_FROM=FareGlide <onboarding@resend.dev>
